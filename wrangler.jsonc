{
  // The K Style 上手屋 官方網站 — 靜態頁 + 細 API（分店已開門狀態，見 _worker/index.js）
  "name": "thekstyle",
  "compatibility_date": "2026-09-19",
  "main": "_worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // 淨係 /api/* 行程式，其餘直接出靜態檔
    "run_worker_first": ["/api/*"]
  },
  // 開門狀態；部署時自動開 KV namespace
  "kv_namespaces": [{ "binding": "STATUS" }],
  "vars": {
    // 路由器用嘅 token 嘅 sha256（token 本身只存喺路由器同 ~/.config/salon/open-token）
    "OPEN_TOKEN_SHA256": "f9b316636cc54f80c06ac62963004cf60f8f7a19b217626f38d12378d073e724"
  }
}
