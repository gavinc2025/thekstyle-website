{
  // The K Style 上手屋 官方網站 — 靜態頁 + 細 API（分店已開門狀態，見 _worker/index.js）
  "name": "thekstyle",
  "compatibility_date": "2026-09-19",
  "main": "_worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // 淨係 /api/* 同員工更表 /r/* 行程式，其餘直接出靜態檔
    "run_worker_first": ["/api/*", "/r/*"]
  },
  // 開門狀態；部署時自動開 KV namespace
  "kv_namespaces": [{ "binding": "STATUS" }],
  "vars": {
    // 路由器用嘅 token 嘅 sha256（可以逗號分隔多個，換 token 時新舊並存；token 本身只存喺路由器同 ~/.config/salon/open-token）
    "OPEN_TOKEN_SHA256": "11c01dd4af89c1fa3338e444c58cf7b4f5402250a60926859cf6bec5be43750e",
    // NAS 推更表用嘅 token 嘅 sha256（token 本身只存喺 NAS 同 ~/.config/salon/roster-push-token）
    "ROSTER_TOKEN_SHA256": "ca444e280d38e15bd8718b29e287c3e7d3853ba2b4d76762eca33e0f598da48d",
    // 員工網頁報數：「1」＝開放（員工頁見到報數卡）；未開時淨係 /r/<碼>?test=1 測試模式用得
    "REPORT_LIVE": "1",
    // 澳門通單據：「1」＝有填澳門通金額（>0）就一定要影（用戶 10/10 定）；大頭工銀一律必須（寫死喺 report.js）
    "REPORT_PHOTO_REQUIRED": "1"
  }
}
